#!/usr/bin/expect -f
# Start a command only after Tenki's interactive SSH prompt is ready.
# Keeping this program in a file preserves the caller's stdin for `interact`.

proc main {argv} {
  if {[llength $argv] != 3} {
    puts stderr "Usage: managed-ssh-bootstrap.exp TENKI_BIN SANDBOX_NAME COMMAND"
    exit 2
  }

  set tenki_bin [lindex $argv 0]
  set name [lindex $argv 1]
  set command [lindex $argv 2]
  set timeout 90

  spawn -noecho $tenki_bin sandbox ssh --session $name
  expect {
    -re {tenki@[^ \r\n]+:[^ \r\n]+[$] $} {
      send -- "$command\r"
      if {$command eq "onboard-telegram-agent"} {
        # Credentials are read interactively by the VM. No secret crosses this helper.
        interact
      }
      expect eof
    }
    timeout {
      puts stderr "Timed out waiting for the managed SSH shell prompt."
      exit 1
    }
    eof {
      puts stderr "Managed SSH ended before the requested command could start."
      exit 1
    }
  }
}

if {![info exists env(EXPECT_PARSE_ONLY)]} {
  main $argv
}
